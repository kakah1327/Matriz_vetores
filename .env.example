# Copie este arquivo para ".env" (local) e preencha com sua chave.
# NO VERCEL: não crie o arquivo .env — cole a chave direto em
# Project Settings > Environment Variables (nome exato abaixo).
#
# Sem prefixo REACT_APP_: a chave é usada só pela função serverless
# em api/gemini.js (lado do servidor), nunca chega ao navegador.

GEMINI_API_KEY=sua_chave_aqui
